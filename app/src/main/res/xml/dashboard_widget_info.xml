<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashboard, placed at 4x2 (Grid).

  The sizes follow Android's own rule for n cells, 70 x n - 30 dp, so the
  launcher places it on exactly the cells named by targetCell*: 4x2.
  The widget itself adapts to whatever it is then given — rotated, resized,
  or on a grid with taller cells — by picking among layouts measured for
  each range (WidgetSizing). That is why minResize can go down to one row:
  shrinking it switches to a layout made for that height instead of
  clipping this one.

  updatePeriodMillis is 0: it is redrawn when the app receives something,
  never on a timer that wakes the phone.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:configure="com.mazeconnect.app.widget.DashboardWidgetConfigureActivity"
    android:initialLayout="@layout/widget_grid"
    android:previewLayout="@layout/widget_preview_grid"
    android:description="@string/widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
