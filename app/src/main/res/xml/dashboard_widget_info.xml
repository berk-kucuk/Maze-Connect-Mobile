<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is 0 on purpose: the system's own period has a 30-minute
  floor and wakes the device to honour it. This widget has nothing to fetch on
  a schedule — it draws whatever the app last saw — so it is redrawn when a
  snapshot arrives instead, and costs nothing in between.

  minResizeWidth/Height are stated rather than left to default, and that
  omission was a real one: without them the smallest a widget can be dragged
  is its minWidth/minHeight, so a home screen whose cells are taller than this
  content gave the widget more room than it asked for and offered no way to
  take it back. minHeight is now measured against the laid-out content rather
  than guessed, and the resize floor sits just under it.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="74dp"
    android:minResizeWidth="200dp"
    android:minResizeHeight="66dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:configure="com.mazeconnect.app.widget.DashboardWidgetConfigureActivity"
    android:initialLayout="@layout/widget_dashboard"
    android:previewLayout="@layout/widget_dashboard"
    android:description="@string/widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
