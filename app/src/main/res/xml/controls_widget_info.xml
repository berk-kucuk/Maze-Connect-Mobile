<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1 of buttons. It was 4x2, which spent a quarter of a screen on four
     short buttons. Update period zero for the same reason as the others: it
     is redrawn when a reading arrives, not on a timer that wakes the
     device. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:configure="com.mazeconnect.app.widget.ControlsWidgetConfigureActivity"
    android:initialLayout="@layout/widget_controls"
    android:previewLayout="@layout/widget_controls"
    android:description="@string/widget_controls_description"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen" />
