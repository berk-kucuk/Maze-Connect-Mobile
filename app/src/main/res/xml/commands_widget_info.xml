<?xml version="1.0" encoding="utf-8"?>
<!--
  Pinned commands, placed at 4x1.

  The sizes follow Android's own rule for n cells, 70 x n - 30 dp, so the
  launcher places it on exactly the cells named by targetCell*: 4x1.
  The widget itself adapts to whatever it is then given — rotated, resized,
  or on a grid with taller cells — by picking among layouts measured for
  each range (WidgetSizing). That is why minResize can go down to one row:
  shrinking it switches to a layout made for that height instead of
  clipping this one.

  updatePeriodMillis is 0: it is redrawn when the app receives something,
  never on a timer that wakes the phone.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:configure="com.mazeconnect.app.widget.CommandsWidgetConfigureActivity"
    android:initialLayout="@layout/widget_commands"
    android:previewLayout="@layout/widget_preview_commands"
    android:description="@string/widget_commands_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
