<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1: the same three readings as the 4x2, across one row instead of down.
     See dashboard_widget_info.xml for why the update period is zero. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:configure="com.mazeconnect.app.widget.DashboardWidgetConfigureActivity"
    android:initialLayout="@layout/widget_compact"
    android:previewLayout="@layout/widget_compact"
    android:description="@string/widget_compact_description"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen" />
