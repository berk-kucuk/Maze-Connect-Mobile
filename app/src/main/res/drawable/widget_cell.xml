<?xml version="1.0" encoding="utf-8"?>
<!-- One tappable cell. Hairline only: a filled cell would read as "on", and
     which state counts as "on" is exactly the thing the words must decide. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0F0F0F" />
    <stroke android:width="1dp" android:color="#33F2F1EC" />
    <corners android:radius="10dp" />
</shape>
