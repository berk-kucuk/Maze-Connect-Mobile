<?xml version="1.0" encoding="utf-8"?>
<!-- A rounded meter: a faint track and a paper fill that brightens toward
     its end. Monochrome — the number beside it says how high. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#24F2F1EC" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="4dp" />
                <gradient
                    android:angle="0"
                    android:startColor="#BFF2F1EC"
                    android:endColor="#F2F1EC" />
            </shape>
        </clip>
    </item>
</layer-list>
