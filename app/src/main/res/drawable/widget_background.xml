<?xml version="1.0" encoding="utf-8"?>
<!-- The card: near-black, a shade lighter at the top so it reads as a
     surface on any wallpaper, with a hairline edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#17171B"
        android:endColor="#0A0A0B" />
    <stroke android:width="1dp" android:color="#1AF2F1EC" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
