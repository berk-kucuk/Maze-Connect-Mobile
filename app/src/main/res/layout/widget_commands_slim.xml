<?xml version="1.0" encoding="utf-8"?>
<!--
  Pinned commands, one row of single-line buttons, for a short cell.

  Measured for 180 x 44 dp (CommandsWidget.SLIM):
    6 padding + (8 + 14.1 label (12sp) + 8) + 6 padding = 42.1
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="6dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/widget_host"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/command_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout android:id="@+id/command_1"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="5dp" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/widget_cell"
            android:paddingVertical="8dp" android:paddingHorizontal="4dp">
            <TextView android:id="@+id/command_name_1" style="@style/WidgetText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:id="@+id/command_2"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="5dp" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/widget_cell"
            android:paddingVertical="8dp" android:paddingHorizontal="4dp">
            <TextView android:id="@+id/command_name_2" style="@style/WidgetText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:id="@+id/command_3"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="5dp" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/widget_cell"
            android:paddingVertical="8dp" android:paddingHorizontal="4dp">
            <TextView android:id="@+id/command_name_3" style="@style/WidgetText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:id="@+id/command_4"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/widget_cell"
            android:paddingVertical="8dp" android:paddingHorizontal="4dp">
            <TextView android:id="@+id/command_name_4" style="@style/WidgetText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hint"
        style="@style/WidgetText.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
