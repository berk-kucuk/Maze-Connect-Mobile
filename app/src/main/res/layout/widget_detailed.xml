<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4x3 dashboard: the same readings as widget_dashboard, given room.

  Two lines per metric instead of one. The wide layout has to abbreviate the
  computer's detail string to fit beside the value — "17.5 / 31.3 GiB" becomes
  "17G" or nothing — and that abbreviation is most of the information. Here the
  label, the value and the whole detail share a line of their own, with the bar
  on its own line beneath at full width.

  Ids are deliberately the same as widget_dashboard's. RemoteViews resolves ids
  within one layout, so reuse across separate layout files is free, and it means
  DashboardWidget.render() fills any size in without knowing which it has. The
  detail views are the only addition; sizes without them declare hasDetail=false
  and render() skips them.

  Weighted rows, for the reason spelled out in widget_dashboard.xml: without
  them the content sits at the top of whatever height the launcher grants and
  the remainder is dead space.

  NestedWeights is suppressed on the meter rows, deliberately.

  The check is right about the mechanism: a weighted row inside a weighted
  container costs an extra measure pass, and the bars inside these rows are
  weighted too. It is wrong about the cost here. This is four rows in a tree a
  dozen views deep, re-inflated when a snapshot lands — at most once every two
  minutes, and never during a scroll or an animation. The alternative is
  pinning the rows to the top and leaving the rest of the card an empty slab,
  which is the bug this replaced.

  The root wraps its content rather than filling the frame.

  A widget is handed a whole number of cells, which is almost never the height
  of this layout. With match_parent the background drawable painted all of it,
  so the leftover showed up as a black band — the "empty space in the widget"
  reported on every size. Arranging that slack (top, centred, spread between
  rows) only moved the band around. wrap_content leaves the remainder
  transparent instead, so the card ends where the content ends.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/widget_host"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F2F1EC" android:textSize="18sp"
            android:maxLines="1" android:ellipsize="end"
            android:text="@string/widget_no_computer" />
        <TextView android:id="@+id/widget_age"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#7A7A7F" android:textSize="13sp" android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_meters"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout android:id="@+id/meter_row_1"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="bottom">
                <TextView android:id="@+id/meter_label_1"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#7A7A7F" android:textSize="13sp" android:maxLines="1" />
                <TextView android:id="@+id/meter_value_1"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#F2F1EC" android:textSize="16sp" android:maxLines="1" />
                <TextView android:id="@+id/meter_detail_1"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#7A7A7F" android:textSize="13sp"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <ProgressBar android:id="@+id/meter_bar_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="10dp"
                android:layout_marginTop="3dp" android:max="100"
                android:progressTint="#F2F1EC" android:progressBackgroundTint="#33F2F1EC" />
        </LinearLayout>

        <LinearLayout android:id="@+id/meter_row_2"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="bottom">
                <TextView android:id="@+id/meter_label_2"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#7A7A7F" android:textSize="13sp" android:maxLines="1" />
                <TextView android:id="@+id/meter_value_2"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#F2F1EC" android:textSize="16sp" android:maxLines="1" />
                <TextView android:id="@+id/meter_detail_2"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#7A7A7F" android:textSize="13sp"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <ProgressBar android:id="@+id/meter_bar_2"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="10dp"
                android:layout_marginTop="3dp" android:max="100"
                android:progressTint="#F2F1EC" android:progressBackgroundTint="#33F2F1EC" />
        </LinearLayout>

        <LinearLayout android:id="@+id/meter_row_3"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="bottom">
                <TextView android:id="@+id/meter_label_3"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#7A7A7F" android:textSize="13sp" android:maxLines="1" />
                <TextView android:id="@+id/meter_value_3"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#F2F1EC" android:textSize="16sp" android:maxLines="1" />
                <TextView android:id="@+id/meter_detail_3"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#7A7A7F" android:textSize="13sp"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <ProgressBar android:id="@+id/meter_bar_3"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="10dp"
                android:layout_marginTop="3dp" android:max="100"
                android:progressTint="#F2F1EC" android:progressBackgroundTint="#33F2F1EC" />
        </LinearLayout>

        <LinearLayout android:id="@+id/meter_row_4"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="bottom">
                <TextView android:id="@+id/meter_label_4"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#7A7A7F" android:textSize="13sp" android:maxLines="1" />
                <TextView android:id="@+id/meter_value_4"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#F2F1EC" android:textSize="16sp" android:maxLines="1" />
                <TextView android:id="@+id/meter_detail_4"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#7A7A7F" android:textSize="13sp"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <ProgressBar android:id="@+id/meter_bar_4"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="10dp"
                android:layout_marginTop="3dp" android:max="100"
                android:progressTint="#F2F1EC" android:progressBackgroundTint="#33F2F1EC" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center"
            android:background="@drawable/widget_cell" android:padding="6dp"
            android:layout_marginEnd="6dp">
            <TextView android:id="@+id/stat_hardening_value"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#F2F1EC" android:textSize="17sp" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#7A7A7F" android:textSize="12sp"
                android:text="@string/widget_stat_hardening" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center"
            android:background="@drawable/widget_cell" android:padding="6dp"
            android:layout_marginEnd="6dp">
            <TextView android:id="@+id/stat_services_value"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#F2F1EC" android:textSize="17sp" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#7A7A7F" android:textSize="12sp"
                android:text="@string/widget_stat_services" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center"
            android:background="@drawable/widget_cell" android:padding="6dp">
            <TextView android:id="@+id/stat_network_value"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#F2F1EC" android:textSize="17sp" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#7A7A7F" android:textSize="12sp"
                android:text="@string/widget_stat_network" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/widget_hint"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:visibility="gone"
        android:textColor="#7A7A7F" android:textSize="13sp" />
</LinearLayout>
