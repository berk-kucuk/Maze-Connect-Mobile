<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashboard, detailed: every reading with the computer's detail on its line,
  and hardening / services / network as three numbers.

  Measured for 180 x 182 dp (DashboardWidget.DETAILED):
    10 padding + 16.4 header + 6
    + 4 x (15.2 line + 3 + 4 bar) + 3 x 6 gaps
    + 8 + 23.2 stat cells + 10 padding = 180.4

  The stat cells are numbers, never names: a home screen is not the place to
  publish which protections a machine is missing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_host"
            style="@style/WidgetText.Host"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_no_computer" />
        <TextView
            android:id="@+id/widget_age"
            style="@style/WidgetText.Age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_meters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/meter_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:id="@+id/meter_label_1" style="@style/WidgetText.Label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/meter_value_1" style="@style/WidgetText.Value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" />
                <TextView android:id="@+id/meter_detail_1" style="@style/WidgetText.Detail"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp"
                    android:gravity="end" />
            </LinearLayout>
            <ProgressBar android:id="@+id/meter_bar_1" style="@style/WidgetBar"
                android:layout_width="match_parent" android:layout_height="4dp"
                android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/meter_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:id="@+id/meter_label_2" style="@style/WidgetText.Label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/meter_value_2" style="@style/WidgetText.Value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" />
                <TextView android:id="@+id/meter_detail_2" style="@style/WidgetText.Detail"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp"
                    android:gravity="end" />
            </LinearLayout>
            <ProgressBar android:id="@+id/meter_bar_2" style="@style/WidgetBar"
                android:layout_width="match_parent" android:layout_height="4dp"
                android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/meter_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:id="@+id/meter_label_3" style="@style/WidgetText.Label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/meter_value_3" style="@style/WidgetText.Value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" />
                <TextView android:id="@+id/meter_detail_3" style="@style/WidgetText.Detail"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp"
                    android:gravity="end" />
            </LinearLayout>
            <ProgressBar android:id="@+id/meter_bar_3" style="@style/WidgetBar"
                android:layout_width="match_parent" android:layout_height="4dp"
                android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/meter_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:id="@+id/meter_label_4" style="@style/WidgetText.Label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/meter_value_4" style="@style/WidgetText.Value"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" />
                <TextView android:id="@+id/meter_detail_4" style="@style/WidgetText.Detail"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp"
                    android:gravity="end" />
            </LinearLayout>
            <ProgressBar android:id="@+id/meter_bar_4" style="@style/WidgetBar"
                android:layout_width="match_parent" android:layout_height="4dp"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="horizontal"
            android:gravity="center" android:background="@drawable/widget_cell"
            android:paddingVertical="4dp">
            <TextView android:id="@+id/stat_hardening_value" style="@style/WidgetText.Value"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView style="@style/WidgetText.Detail"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="5dp" android:text="@string/widget_stat_hardening" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="horizontal"
            android:gravity="center" android:background="@drawable/widget_cell"
            android:paddingVertical="4dp">
            <TextView android:id="@+id/stat_services_value" style="@style/WidgetText.Value"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView style="@style/WidgetText.Detail"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="5dp" android:text="@string/widget_stat_services" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal"
            android:gravity="center" android:background="@drawable/widget_cell"
            android:paddingVertical="4dp">
            <TextView android:id="@+id/stat_network_value" style="@style/WidgetText.Value"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView style="@style/WidgetText.Detail"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="5dp" android:text="@string/widget_stat_network" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hint"
        style="@style/WidgetText.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="4"
        android:visibility="gone" />
</LinearLayout>
