<?xml version="1.0" encoding="utf-8"?>
<!--
  Pinned commands, normal height: the computer's name, then four buttons of
  up to two lines each.

  Measured for 180 x 88 dp (CommandsWidget.NORMAL):
    8 padding + 15.2 header + 5 + (10 + 2 x 15.2 label + 10) + 8 padding = 86.6
  Every cell is held to the two-line height, so a row of one- and two-line
  labels stays level.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_host"
            style="@style/WidgetText.Host"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:text="@string/widget_no_computer" />
        <TextView
            android:id="@+id/widget_age"
            style="@style/WidgetText.Age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/command_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout android:id="@+id/command_1"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="5dp" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/widget_cell"
            android:minHeight="50dp"
            android:paddingVertical="10dp" android:paddingHorizontal="4dp">
            <TextView android:id="@+id/command_name_1" style="@style/WidgetText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:maxLines="2" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:id="@+id/command_2"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="5dp" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/widget_cell"
            android:minHeight="50dp"
            android:paddingVertical="10dp" android:paddingHorizontal="4dp">
            <TextView android:id="@+id/command_name_2" style="@style/WidgetText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:maxLines="2" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:id="@+id/command_3"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="5dp" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/widget_cell"
            android:minHeight="50dp"
            android:paddingVertical="10dp" android:paddingHorizontal="4dp">
            <TextView android:id="@+id/command_name_3" style="@style/WidgetText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:maxLines="2" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:id="@+id/command_4"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/widget_cell"
            android:minHeight="50dp"
            android:paddingVertical="10dp" android:paddingHorizontal="4dp">
            <TextView android:id="@+id/command_name_4" style="@style/WidgetText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:maxLines="2" android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hint"
        style="@style/WidgetText.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
