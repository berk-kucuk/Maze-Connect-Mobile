<?xml version="1.0" encoding="utf-8"?>
<!--
  Commands, on the home screen.

  Mirrors widget_controls.xml almost exactly — one row of cells, one cell
  high — except a cell here is just a label: commands have no persistent
  on/off state to show, unlike a killswitch, so there is nothing to draw
  besides what a tap will run.

  Which commands appear here is decided entirely on the computer (see
  CommandsView.qml's "Show on phone widget" toggle) and written down by
  WidgetSnapshotStore whenever a catalog arrives; this layout only ever
  draws whatever it was handed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_host"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F2F1EC"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_no_computer" />
        <TextView
            android:id="@+id/widget_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#7A7A7F"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/command_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout android:id="@+id/command_1"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:layout_marginEnd="4dp"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:paddingStart="4dp" android:paddingEnd="4dp"
            android:background="@drawable/widget_cell">
            <TextView android:id="@+id/command_name_1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#F2F1EC" android:textSize="11sp"
                android:maxLines="2" android:gravity="center" />
        </LinearLayout>

        <LinearLayout android:id="@+id/command_2"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:layout_marginEnd="4dp"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:paddingStart="4dp" android:paddingEnd="4dp"
            android:background="@drawable/widget_cell">
            <TextView android:id="@+id/command_name_2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#F2F1EC" android:textSize="11sp"
                android:maxLines="2" android:gravity="center" />
        </LinearLayout>

        <LinearLayout android:id="@+id/command_3"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:layout_marginEnd="4dp"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:paddingStart="4dp" android:paddingEnd="4dp"
            android:background="@drawable/widget_cell">
            <TextView android:id="@+id/command_name_3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#F2F1EC" android:textSize="11sp"
                android:maxLines="2" android:gravity="center" />
        </LinearLayout>

        <LinearLayout android:id="@+id/command_4"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:paddingStart="4dp" android:paddingEnd="4dp"
            android:background="@drawable/widget_cell">
            <TextView android:id="@+id/command_name_4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#F2F1EC" android:textSize="11sp"
                android:maxLines="2" android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#7A7A7F"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
