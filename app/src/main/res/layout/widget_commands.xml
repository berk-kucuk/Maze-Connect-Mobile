<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <ImageView
            android:id="@+id/widget_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/widget_dot_stale"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/widget_host"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/WidgetText.Host.Small"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:text="@string/widget_no_computer" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/WidgetText.Tag"
            android:layout_marginStart="8dp"
            android:text="Commands" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/command_row"
        android:layout_marginTop="6dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <LinearLayout
                android:id="@+id/command_1"
                android:layout_width="0dp"
                android:layout_height="27dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_pill"
                android:layout_marginEnd="5dp"
                android:paddingHorizontal="11dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_commands"
                    android:tint="#8E8E93"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/command_name_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/WidgetText.Pill"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/command_2"
                android:layout_width="0dp"
                android:layout_height="27dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_pill"
                android:paddingHorizontal="11dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_commands"
                    android:tint="#8E8E93"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/command_name_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/WidgetText.Pill"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:id="@+id/command_row_2"
            android:layout_marginTop="5dp">
            <LinearLayout
                android:id="@+id/command_3"
                android:layout_width="0dp"
                android:layout_height="27dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_pill"
                android:layout_marginEnd="5dp"
                android:paddingHorizontal="11dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_commands"
                    android:tint="#8E8E93"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/command_name_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/WidgetText.Pill"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/command_4"
                android:layout_width="0dp"
                android:layout_height="27dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_pill"
                android:paddingHorizontal="11dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_commands"
                    android:tint="#8E8E93"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/command_name_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/WidgetText.Pill"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/WidgetText.Hint"
        android:layout_marginTop="6dp"
        android:maxLines="3"
        android:visibility="gone"
        android:textSize="11sp" />
</LinearLayout>
