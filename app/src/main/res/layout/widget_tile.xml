<?xml version="1.0" encoding="utf-8"?>
<!--
  GENERATED by tools/gen_widget_layouts.py — edit that, not this file.

  A small square: two ring gauges with their detail.

  Measured for 110 x 137 dp (text is 1.17 x its size, font padding off):
    11 + 16.4 header + 10 + 40 ring + 8 + 40 ring + 11 = 136.4
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="12dp"
    android:paddingVertical="11dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <ImageView
            android:id="@+id/widget_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/widget_dot_stale"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/widget_host"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/WidgetText.Host"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:text="@string/widget_no_computer" />
        <TextView
            android:id="@+id/widget_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/WidgetText.Age"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/widget_meters">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:id="@+id/meter_row_1"
            android:layout_marginTop="10dp">
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">
                <ProgressBar
                    android:id="@+id/meter_bar_1"
                    style="@style/WidgetRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <TextView
                    android:id="@+id/meter_value_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    style="@style/WidgetText.Ring" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="9dp">
                <TextView
                    android:id="@+id/meter_label_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/WidgetText.Title" />
                <TextView
                    android:id="@+id/meter_detail_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/WidgetText.Detail"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:id="@+id/meter_row_2"
            android:layout_marginTop="8dp">
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">
                <ProgressBar
                    android:id="@+id/meter_bar_2"
                    style="@style/WidgetRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <TextView
                    android:id="@+id/meter_value_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    style="@style/WidgetText.Ring" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="9dp">
                <TextView
                    android:id="@+id/meter_label_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/WidgetText.Title" />
                <TextView
                    android:id="@+id/meter_detail_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/WidgetText.Detail"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/WidgetText.Hint"
        android:layout_marginTop="8dp"
        android:maxLines="5"
        android:visibility="gone" />
</LinearLayout>
