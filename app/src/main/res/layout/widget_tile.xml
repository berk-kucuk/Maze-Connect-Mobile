<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashboard square: two readings, each with the computer's detail beneath
  ("45 °C", "17.5 / 31.3 GiB").

  Measured for 110 x 122 dp (DashboardWidget.TILE):
    10 padding + 16.4 name (14sp)
    + 2 x (7|6 gap + 15.2 label/value + 3 + 4 bar + 2 + 11.7 detail)
    + 10 padding = 121.2
  No age line: at this width it would push the name to an ellipsis. The age
  is on every wider layout.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/widget_host"
        style="@style/WidgetText.Host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_no_computer" />

    <TextView
        android:id="@+id/widget_age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/meter_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/meter_label_1" style="@style/WidgetText.Label"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView android:id="@+id/meter_value_1" style="@style/WidgetText.Value"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <ProgressBar android:id="@+id/meter_bar_1" style="@style/WidgetBar"
            android:layout_width="match_parent" android:layout_height="4dp"
            android:layout_marginTop="3dp" />
        <TextView android:id="@+id/meter_detail_1" style="@style/WidgetText.Detail"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/meter_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/meter_label_2" style="@style/WidgetText.Label"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView android:id="@+id/meter_value_2" style="@style/WidgetText.Value"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <ProgressBar android:id="@+id/meter_bar_2" style="@style/WidgetBar"
            android:layout_width="match_parent" android:layout_height="4dp"
            android:layout_marginTop="3dp" />
        <TextView android:id="@+id/meter_detail_2" style="@style/WidgetText.Detail"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hint"
        style="@style/WidgetText.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="4"
        android:visibility="gone" />
</LinearLayout>
