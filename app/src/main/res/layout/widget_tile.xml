<?xml version="1.0" encoding="utf-8"?>
<!--
  The 2x2 square: two readings, with their detail, in the footprint of four
  app icons.

  The same two-line row as widget_detailed rather than the wide layout's
  label|bar|value, because at this width there is no room for three columns —
  a 56dp label beside a 40dp value would leave the bar barely wider than the
  padding. Stacking gives the bar the full width and the detail somewhere to
  live.

  No stat cells and no age line: at 110dp square the choice is between two
  real readings and a scattering of half-legible ones.

  Weighted rows, for the reason spelled out in widget_dashboard.xml.

  NestedWeights is suppressed on the meter rows, deliberately.

  The check is right about the mechanism: a weighted row inside a weighted
  container costs an extra measure pass, and the bars inside these rows are
  weighted too. It is wrong about the cost here. This is four rows in a tree a
  dozen views deep, re-inflated when a snapshot lands — at most once every two
  minutes, and never during a scroll or an animation. The alternative is
  pinning the rows to the top and leaving the rest of the card an empty slab,
  which is the bug this replaced.

  The root wraps its content rather than filling the frame.

  A widget is handed a whole number of cells, which is almost never the height
  of this layout. With match_parent the background drawable painted all of it,
  so the leftover showed up as a black band — the "empty space in the widget"
  reported on every size. Arranging that slack (top, centred, spread between
  rows) only moved the band around. wrap_content leaves the remainder
  transparent instead, so the card ends where the content ends.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView android:id="@+id/widget_host"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#F2F1EC" android:textSize="21sp"
        android:maxLines="1" android:ellipsize="end"
        android:text="@string/widget_no_computer" />

    <TextView android:id="@+id/widget_age"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#7A7A7F" android:textSize="14sp" android:maxLines="1" />

    <LinearLayout
        android:id="@+id/widget_meters"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout android:id="@+id/meter_row_1"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="bottom">
                <TextView android:id="@+id/meter_label_1"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#7A7A7F" android:textSize="14sp" android:maxLines="1" />
                <TextView android:id="@+id/meter_value_1"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#F2F1EC" android:textSize="20sp" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/meter_detail_1"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#7A7A7F" android:textSize="14sp"
                android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/meter_bar_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="14dp"
                android:layout_marginTop="3dp" android:max="100"
                android:progressTint="#F2F1EC" android:progressBackgroundTint="#33F2F1EC" />
        </LinearLayout>

        <LinearLayout android:id="@+id/meter_row_2"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="bottom">
                <TextView android:id="@+id/meter_label_2"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#7A7A7F" android:textSize="14sp" android:maxLines="1" />
                <TextView android:id="@+id/meter_value_2"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#F2F1EC" android:textSize="20sp" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/meter_detail_2"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#7A7A7F" android:textSize="14sp"
                android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/meter_bar_2"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="14dp"
                android:layout_marginTop="3dp" android:max="100"
                android:progressTint="#F2F1EC" android:progressBackgroundTint="#33F2F1EC" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/widget_hint"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:visibility="gone"
        android:textColor="#7A7A7F" android:textSize="14sp" />
</LinearLayout>
