<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="10dp"
    android:paddingVertical="9dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <ImageView
            android:id="@+id/widget_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/widget_dot_live"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/widget_host"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/WidgetText.Host.Small"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:text="maze-desktop" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/WidgetText.Tag"
            android:layout_marginStart="8dp"
            android:text="Guard" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:id="@+id/control_row"
        android:layout_marginTop="7dp">
        <LinearLayout
            android:id="@+id/control_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_cell_on"
            android:orientation="vertical"
            android:layout_marginEnd="6dp"
            android:paddingVertical="6dp">
            <ImageView
                android:id="@+id/control_icon_1"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_camera"
                android:contentDescription="@null"
                android:tint="#0A0A0B" />
            <TextView
                android:id="@+id/control_name_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WidgetText.CellName"
                android:layout_marginTop="3dp"
                android:text="Camera"
                android:textColor="#0A0A0B" />
            <TextView
                android:id="@+id/control_state_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WidgetText.CellState"
                android:layout_marginTop="2dp"
                android:text="Blocked"
                android:textColor="#9E0A0A0B" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/control_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_cell_on"
            android:orientation="vertical"
            android:layout_marginEnd="6dp"
            android:paddingVertical="6dp">
            <ImageView
                android:id="@+id/control_icon_2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_microphone"
                android:contentDescription="@null"
                android:tint="#0A0A0B" />
            <TextView
                android:id="@+id/control_name_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WidgetText.CellName"
                android:layout_marginTop="3dp"
                android:text="Mic"
                android:textColor="#0A0A0B" />
            <TextView
                android:id="@+id/control_state_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WidgetText.CellState"
                android:layout_marginTop="2dp"
                android:text="Blocked"
                android:textColor="#9E0A0A0B" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/control_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_cell"
            android:orientation="vertical"
            android:layout_marginEnd="6dp"
            android:paddingVertical="6dp">
            <ImageView
                android:id="@+id/control_icon_3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_wifi"
                android:contentDescription="@null"
                android:tint="#F2F1EC" />
            <TextView
                android:id="@+id/control_name_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WidgetText.CellName"
                android:layout_marginTop="3dp"
                android:text="Wi-Fi"
                android:textColor="#F2F1EC" />
            <TextView
                android:id="@+id/control_state_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WidgetText.CellState"
                android:layout_marginTop="2dp"
                android:text="Allowed"
                android:textColor="#8E8E93" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/control_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_cell_off"
            android:orientation="vertical"
            android:paddingVertical="6dp">
            <ImageView
                android:id="@+id/control_icon_4"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_bluetooth"
                android:contentDescription="@null"
                android:tint="#56565B" />
            <TextView
                android:id="@+id/control_name_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WidgetText.CellName"
                android:layout_marginTop="3dp"
                android:text="BT"
                android:textColor="#56565B" />
            <TextView
                android:id="@+id/control_state_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WidgetText.CellState"
                android:layout_marginTop="2dp"
                android:text="Absent"
                android:textColor="#56565B" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/WidgetText.Hint"
        android:layout_marginTop="6dp"
        android:maxLines="3"
        android:visibility="gone"
        android:textSize="11sp" />
</LinearLayout>
