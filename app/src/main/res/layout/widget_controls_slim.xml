<?xml version="1.0" encoding="utf-8"?>
<!--
  Killswitches, one row: for a 4x1 in landscape or a short grid, where there
  is no room for the name above the cells. Icon beside the words instead of
  above them.

  Measured for 250 x 46 dp (ControlsWidget.SLIM):
    5 padding + (6 + 24.6 name/state + 6) + 5 padding = 46.6
  Needs 250 dp across: four cells of icon plus "blocked" do not fit narrower.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="6dp"
    android:paddingVertical="5dp">

    <TextView
        android:id="@+id/widget_host"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/control_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout android:id="@+id/control_1"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="5dp" android:orientation="horizontal"
            android:gravity="center" android:background="@drawable/widget_cell"
            android:paddingVertical="6dp" android:paddingHorizontal="4dp">
            <ImageView android:id="@+id/control_icon_1"
                android:layout_width="16dp" android:layout_height="16dp"
                android:src="@drawable/ic_camera" android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="5dp" android:orientation="vertical">
                <TextView android:id="@+id/control_name_1" style="@style/WidgetText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" />
                <TextView android:id="@+id/control_state_1" style="@style/WidgetText.Detail"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/control_2"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="5dp" android:orientation="horizontal"
            android:gravity="center" android:background="@drawable/widget_cell"
            android:paddingVertical="6dp" android:paddingHorizontal="4dp">
            <ImageView android:id="@+id/control_icon_2"
                android:layout_width="16dp" android:layout_height="16dp"
                android:src="@drawable/ic_microphone" android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="5dp" android:orientation="vertical">
                <TextView android:id="@+id/control_name_2" style="@style/WidgetText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" />
                <TextView android:id="@+id/control_state_2" style="@style/WidgetText.Detail"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/control_3"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="5dp" android:orientation="horizontal"
            android:gravity="center" android:background="@drawable/widget_cell"
            android:paddingVertical="6dp" android:paddingHorizontal="4dp">
            <ImageView android:id="@+id/control_icon_3"
                android:layout_width="16dp" android:layout_height="16dp"
                android:src="@drawable/ic_wifi" android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="5dp" android:orientation="vertical">
                <TextView android:id="@+id/control_name_3" style="@style/WidgetText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" />
                <TextView android:id="@+id/control_state_3" style="@style/WidgetText.Detail"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/control_4"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal"
            android:gravity="center" android:background="@drawable/widget_cell"
            android:paddingVertical="6dp" android:paddingHorizontal="4dp">
            <ImageView android:id="@+id/control_icon_4"
                android:layout_width="16dp" android:layout_height="16dp"
                android:src="@drawable/ic_bluetooth" android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="5dp" android:orientation="vertical">
                <TextView android:id="@+id/control_name_4" style="@style/WidgetText"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" />
                <TextView android:id="@+id/control_state_4" style="@style/WidgetText.Detail"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hint"
        style="@style/WidgetText.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
