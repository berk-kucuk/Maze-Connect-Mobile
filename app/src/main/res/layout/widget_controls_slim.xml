<?xml version="1.0" encoding="utf-8"?>
<!--
  GENERATED by tools/gen_widget_layouts.py — edit that, not this file.

  Killswitches in one row, for a short cell (4x1 in landscape).

  Measured for 250 x 46 dp (text is 1.17 x its size, font padding off):
    6 + (8 + 18 icon + 8) + 6 = 46
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:id="@+id/control_row">
        <LinearLayout
            android:id="@+id/control_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_cell"
            android:orientation="horizontal"
            android:layout_marginEnd="6dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="8dp">
            <ImageView
                android:id="@+id/control_icon_1"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_camera"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/control_name_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WidgetText.CellName"
                android:layout_marginStart="7dp" />
            <TextView
                android:id="@+id/control_state_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WidgetText.CellState"
                android:layout_marginStart="4dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/control_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_cell"
            android:orientation="horizontal"
            android:layout_marginEnd="6dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="8dp">
            <ImageView
                android:id="@+id/control_icon_2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_microphone"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/control_name_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WidgetText.CellName"
                android:layout_marginStart="7dp" />
            <TextView
                android:id="@+id/control_state_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WidgetText.CellState"
                android:layout_marginStart="4dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/control_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_cell"
            android:orientation="horizontal"
            android:layout_marginEnd="6dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="8dp">
            <ImageView
                android:id="@+id/control_icon_3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_wifi"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/control_name_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WidgetText.CellName"
                android:layout_marginStart="7dp" />
            <TextView
                android:id="@+id/control_state_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WidgetText.CellState"
                android:layout_marginStart="4dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/control_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_cell"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:paddingHorizontal="8dp">
            <ImageView
                android:id="@+id/control_icon_4"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_bluetooth"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/control_name_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WidgetText.CellName"
                android:layout_marginStart="7dp" />
            <TextView
                android:id="@+id/control_state_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WidgetText.CellState"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/WidgetText.Hint"
        android:layout_marginTop="0dp"
        android:maxLines="2"
        android:visibility="gone"
        android:textSize="11sp"
        android:layout_marginHorizontal="6dp" />
</LinearLayout>
