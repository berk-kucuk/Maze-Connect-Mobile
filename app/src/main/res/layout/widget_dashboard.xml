<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashboard: name and age, then four readings as label | bar | value.

  Measured for 180 x 116 dp (DashboardWidget.DASHBOARD):
    10 padding + 16.4 header (14sp) + 6 + 4 x 15.2 rows (13sp) + 3 x 4 gaps
    + 10 padding = 115.2
  Exactly a 4x1 on Samsung's tall grid, and a 4x2 in landscape.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_host"
            style="@style/WidgetText.Host"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_no_computer" />
        <TextView
            android:id="@+id/widget_age"
            style="@style/WidgetText.Age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_meters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/meter_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/meter_label_1" style="@style/WidgetText.Label"
                android:layout_width="40dp" android:layout_height="wrap_content" />
            <ProgressBar android:id="@+id/meter_bar_1" style="@style/WidgetBar"
                android:layout_width="0dp" android:layout_height="5dp"
                android:layout_weight="1" />
            <TextView android:id="@+id/meter_value_1" style="@style/WidgetText.Value"
                android:layout_width="40dp" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:gravity="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/meter_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/meter_label_2" style="@style/WidgetText.Label"
                android:layout_width="40dp" android:layout_height="wrap_content" />
            <ProgressBar android:id="@+id/meter_bar_2" style="@style/WidgetBar"
                android:layout_width="0dp" android:layout_height="5dp"
                android:layout_weight="1" />
            <TextView android:id="@+id/meter_value_2" style="@style/WidgetText.Value"
                android:layout_width="40dp" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:gravity="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/meter_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/meter_label_3" style="@style/WidgetText.Label"
                android:layout_width="40dp" android:layout_height="wrap_content" />
            <ProgressBar android:id="@+id/meter_bar_3" style="@style/WidgetBar"
                android:layout_width="0dp" android:layout_height="5dp"
                android:layout_weight="1" />
            <TextView android:id="@+id/meter_value_3" style="@style/WidgetText.Value"
                android:layout_width="40dp" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:gravity="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/meter_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/meter_label_4" style="@style/WidgetText.Label"
                android:layout_width="40dp" android:layout_height="wrap_content" />
            <ProgressBar android:id="@+id/meter_bar_4" style="@style/WidgetBar"
                android:layout_width="0dp" android:layout_height="5dp"
                android:layout_weight="1" />
            <TextView android:id="@+id/meter_value_4" style="@style/WidgetText.Value"
                android:layout_width="40dp" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:gravity="end" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hint"
        style="@style/WidgetText.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="3"
        android:visibility="gone" />
</LinearLayout>
