<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashboard, smallest: the computer's name and two readings as numbers.

  Measured for 110 x 48 dp (DashboardWidget.MINI):
    7 padding + 15.2 name (13sp) + 3 + 15.2 values (13sp) + 7 padding = 47.4
  No bars at this size — a bar narrower than its own label says nothing.

  The root carries @android:id/background so Android 12+ clips it to the
  launcher's own corner radius instead of drawing ours over it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="12dp"
    android:paddingVertical="7dp">

    <TextView
        android:id="@+id/widget_host"
        style="@style/WidgetText.Host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:text="@string/widget_no_computer" />

    <TextView
        android:id="@+id/widget_age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_meters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/meter_row_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/meter_label_1" style="@style/WidgetText.Label"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/meter_value_1" style="@style/WidgetText.Value"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/meter_row_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/meter_label_2" style="@style/WidgetText.Label"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/meter_value_2" style="@style/WidgetText.Value"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hint"
        style="@style/WidgetText.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
